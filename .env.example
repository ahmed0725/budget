# Copy to .env and adjust (on a hosting platform, set these as environment variables).

# PostgreSQL connection string. For local development `npm run db:start` runs an
# embedded PostgreSQL server on port 54329 using the credentials below. In production
# use your PostgreSQL server (e.g. Neon or Supabase), with ?sslmode=require if needed.
DATABASE_URL="postgresql://gbms:gbms_dev_password@localhost:54329/gbms"
# Server used by the integration and end-to-end tests (they create throwaway databases on it).
TEST_DATABASE_URL="postgresql://gbms:gbms_dev_password@localhost:54329/gbms_test"

# Random secret (at least 32 bytes, base64) used as a pepper for session-token hashes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Directory for uploaded attachments and Excel import files (never inside /public).
# In production use a persistent directory outside the application folder.
STORAGE_DIR="./storage"

# "true" when served over HTTPS (production). Adds the Secure flag to cookies.
SECURE_COOKIES="false"

# ── Deployment ──────────────────────────────────────────────────────────────
# "true" makes `npm run build` also apply migrations and, on an empty database,
# load the seed (for hosts without shell access, such as Hostinger Node.js apps).
DEPLOY_DB_SETUP="false"
# Password of the demo accounts created by the seed (required when demo data is loaded
# on a server; keep it private).
SEED_DEV_PASSWORD=""
# "true" loads only configuration and reference data — no demo accounts or demo budgets.
SEED_SKIP_DEV="false"
# Public domain(s), comma-separated, if form submissions fail behind a proxy.
SERVER_ACTIONS_ALLOWED_ORIGINS=""
